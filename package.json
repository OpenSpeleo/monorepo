{
  "name": "speleodb-monorepo",
  "version": "1.0.0",
  "private": true,
  "description": "SpeleoDB Git submodule workspace",
  "workspaces": [
    "apps/mobile",
    "apps/web",
    "packages/typescript/*/"
  ],
  "engines": {
    "bun": "1.4.2"
  },
  "overrides": {
    "@speleodb/api": "workspace:*",
    "@speleodb/map-core": "workspace:*",
    "@speleodb/map-viewer": "workspace:*",
    "maplibre-gl": "https://github.com/DEKHTIARJonathan/maplibre-gl-js/archive/0566606682dc786d56e37214199901407fa51d89.tar.gz"
  },
  "packageManager": "bun@1.4.2",
  "trustedDependencies": [
    "@sentry/capacitor",
    "esbuild",
    "fsevents"
  ],
  "scripts": {
    "lock": "bun utilities/bun-lock/lock.mjs",
    "install:local": "bun .devcontainer/install-typescript-packages.mjs",
    "postinstall": "bun run lock"
  }
}
